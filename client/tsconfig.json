{
    "compilerOptions": {
        "incremental": true,
        "tsBuildInfoFile": "../build/client/tsconfig.tsbuildinfo",
        "target": "es2019",
        "module": "commonjs",
        "moduleResolution": "bundler",
        "rootDir": ".",
        "outDir": "../build/client",
        "esModuleInterop": true,
        "strict": true,
        "sourceMap": true,
        "lib": [ "dom", "dom.iterable", "es2017" ],
        "types": [],
        "skipLibCheck": true
    },
    "watchOptions": {
        "watchFile": "useFsEvents",
        "watchDirectory": "useFsEvents",
        "fallbackPolling": "dynamicPriority"
    },
    "include": [
        "./**/*"
    ],
    "exclude": [
        "build",
        "node_modules",
        "coverage",
        "./**/*.config.mjs"
    ]
}
